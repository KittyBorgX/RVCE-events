# Copy this file to deploy/server.env on the deployment server only.
# Do not commit deploy/server.env.

# Image registry and release tag. The deploy script temporarily overrides IMAGE_TAG.
REGISTRY=ghcr.io
IMAGE_NAMESPACE=your-github-owner
IMAGE_TAG=main

# The frontend is bound only to loopback. A reverse proxy on the server should
# terminate TLS and proxy public traffic to this port.
FRONTEND_PORT=3000

# PostgreSQL. Use a long random value for POSTGRES_PASSWORD.
POSTGRES_DB=rvce_events
POSTGRES_USER=rvce_events_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# This file is used only for Docker Compose variable substitution. Each value
# is passed only to the container fields explicitly declared in docker-compose.yml.
# Application-specific values (for example JWT keys, SMTP credentials, SSO
# configuration, and message-broker credentials) will get separate server-only
# files when the corresponding service is implemented.
